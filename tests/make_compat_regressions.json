  {
    "name": "commandline_env_append",
    "text": "all:\n\t@$(MAKE) -f child.mk\n",
    "files": {
      "child.mk": "all:\n\t@echo \"$(VAR)\" > result\n"
    },
    "args": [
      "all",
      "VAR+=second"
    ],
    "extra_env": {
      "VAR": "first"
    },
    "inspect": [
      "result"
    ],
    "expected_status": 0,
    "expected_files": {
      "result": "first second\n"
    }
  },
