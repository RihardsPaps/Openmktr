[
  {
    "name": "primary_double_remake",
    "text": "all:\n\t@echo OK > result\nMakefile::\n\t@touch Makefile\n",
    "inspect": [
      "result"
    ],
    "expected_status": 0,
    "expected_files": {
      "result": "OK\n"
    }
  },
  {
    "name": "primary_phony_remake",
    "text": ".PHONY: Makefile\nall:\n\t@echo OK > result\nMakefile:\n\t@touch Makefile\n",
    "inspect": [
      "result"
    ],
    "expected_status": 0,
    "expected_files": {
      "result": "OK\n"
    }
  },
  {
    "name": "vpath_transitive",
    "text": "VPATH=src\nall: generated\n\t@cat $< > result\ngenerated: input\n\t@cp $< $@\ninput: seed\n\t@cp $< $@\n",
    "files": {
      "src/generated": "old",
      "input": "old",
      "seed": "NEW"
    },
    "times": {
      "src/generated": 200,
      "input": 100,
      "seed": 300
    },
    "inspect": [
      "result",
      "generated",
      "input"
    ],
    "expected_status": 0,
    "expected_files": {
      "result": "NEW",
      "generated": "NEW",
      "input": "NEW"
    }
  },
  {
    "name": "vpath_transitive_ninja",
    "text": "VPATH=src\nall: generated\n\t@cat $< > result\ngenerated: input\n\t@cp $< $@\ninput: seed\n\t@cp $< $@\n",
    "files": {
      "src/generated": "old",
      "input": "old",
      "seed": "NEW"
    },
    "times": {
      "src/generated": 200,
      "input": 100,
      "seed": 300
    },
    "inspect": [
      "result",
      "generated",
      "input"
    ],
    "ninja": true,
    "expected_status": 0,
    "expected_files": {
      "result": "NEW",
      "generated": "NEW",
      "input": "NEW"
    }
  },
  {
    "name": "intermediate_transitive",
    "text": "all: final\n.INTERMEDIATE: middle\nfinal: middle\n\t@cp $< $@\nmiddle: input\n\t@cp $< $@\ninput: seed\n\t@cp $< $@\n",
    "files": {
      "final": "old",
      "input": "old",
      "seed": "NEW"
    },
    "times": {
      "final": 200,
      "input": 100,
      "seed": 300
    },
    "inspect": [
      "final",
      "input"
    ],
    "expected_status": 0,
    "expected_files": {
      "final": "NEW",
      "input": "NEW"
    }
  },
  {
    "name": "intermediate_new_sibling",
    "text": "all: final\n.INTERMEDIATE: middle\nfinal: middle newer\n\t@cat middle newer > final\nmiddle: input\n\t@cp $< $@\n",
    "files": {
      "final": "old",
      "input": "I",
      "newer": "N"
    },
    "times": {
      "final": 200,
      "input": 100,
      "newer": 300
    },
    "inspect": [
      "final"
    ],
    "expected_status": 0,
    "expected_files": {
      "final": "IN"
    }
  },
  {
    "name": "intermediate_whatif",
    "text": "all: final\n.INTERMEDIATE: middle\nfinal: middle\n\t@cp $< $@\nmiddle: input\n\t@cp $< $@\n",
    "files": {
      "final": "old",
      "input": "NEW"
