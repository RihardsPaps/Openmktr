set -eu
case ${OMKTR_PORTAGE_MODE:-direct} in
  direct|ninja) ;;
  *) printf '%s\n' 'omktr-portage: OMKTR_PORTAGE_MODE must be direct or ninja' >&2
     exit 2 ;;
esac

# Manager defaults precede explicit ebuild arguments.
case ${OMKTR_PORTAGE_GRAPH_OPTIMIZATIONS:-} in
  '') ;;
  off|safe|aggressive) set -- "--graph_optimizations=${OMKTR_PORTAGE_GRAPH_OPTIMIZATIONS}" "$@" ;;
  *) exit 2 ;;
esac
case ${OMKTR_PORTAGE_RECURSIVE_CACHE:-0} in
  0) ;; 1) set -- --recursive_cache "$@" ;; *) exit 2 ;;
esac
case ${OMKTR_PORTAGE_STRICT_COMPAT:-0} in
  0) ;; 1) set -- --strict-compat "$@" ;; *) exit 2 ;;
esac

# Portage configuration uses an absolute pathname. Also permit PATH invocation
# for diagnostics, without changing the caller's recipe working directory.
wrapper=$0
case $wrapper in
  */*) ;;
  *) wrapper=$(command -v "$wrapper") ;;
esac
bindir=$(CDPATH= cd -P "$(dirname "$wrapper")" && pwd)
MAKE=$bindir/omktr
export MAKE
if [ ! -x "$MAKE" ]; then
  printf 'omktr-portage: sibling executable is missing: %s\n' "$MAKE" >&2
  exit 127
fi

if [ "${OMKTR_PORTAGE_MODE:-direct}" = ninja ] &&
   [ "${EBUILD_PHASE:-}" = compile ]; then
  exec "$MAKE" build "$@"
fi
exec "$MAKE" "$@"
