#!/bin/sh
set -eu

formatter=${CLANG_FORMAT:-clang-format}
formatted=$(mktemp)
trap 'rm -f "$formatted"' EXIT HUP INT TERM

if [ -n "${CLANG_FORMAT_FILES:-}" ]; then
  # CI supplies repository-relative C++ paths changed by this patch.
  set -- $CLANG_FORMAT_FILES
else
  set -- src/*.cc src/*.h
fi

for source do
  "$formatter" "$source" > "$formatted"
  if ! cmp -s "$formatted" "$source"; then
    printf 'Formatting differs: %s\n' "$source" >&2
    exit 1
  fi
done
