# Portable, GNU-free Linux build. Run with Ninja in a musl environment.
cxx = clang++
cxxflags = -std=c++17 -O2 -DNOLOG -Wall -Wextra -stdlib=libc++ -pthread -flto=thin -ffunction-sections -fdata-sections
ldflags = -stdlib=libc++ -fuse-ld=lld -pthread -flto=thin -Wl,--gc-sections -Wl,--icf=safe

rule mkdir
  command = mkdir -p $out
  description = MKDIR $out

rule cxx
  command = $cxx $cxxflags -MMD -MF $out.d -c $in -o $out
  depfile = $out.d
  deps = gcc
  description = CXX $out

rule link
  command = $cxx $ldflags $in -o $out
  description = LINK $out

build out: mkdir

build out/affinity.o: cxx src/affinity.cc || out
build out/command.o: cxx src/command.cc || out
build out/dep.o: cxx src/dep.cc || out
build out/eval.o: cxx src/eval.cc || out
build out/exec.o: cxx src/exec.cc || out
build out/expr.o: cxx src/expr.cc || out
build out/file.o: cxx src/file.cc || out
build out/file_cache.o: cxx src/file_cache.cc || out
build out/fileutil.o: cxx src/fileutil.cc || out
build out/find.o: cxx src/find.cc || out
build out/flags.o: cxx src/flags.cc || out
build out/func.o: cxx src/func.cc || out
build out/io.o: cxx src/io.cc || out
build out/log.o: cxx src/log.cc || out
build out/ninja.o: cxx src/ninja.cc || out
build out/parser.o: cxx src/parser.cc || out
build out/regen.o: cxx src/regen.cc || out
build out/regen_dump.o: cxx src/regen_dump.cc || out
build out/rule.o: cxx src/rule.cc || out
build out/stats.o: cxx src/stats.cc || out
build out/stmt.o: cxx src/stmt.cc || out
build out/stringprintf.o: cxx src/stringprintf.cc || out
build out/strutil.o: cxx src/strutil.cc || out
build out/symtab.o: cxx src/symtab.cc || out
build out/timeutil.o: cxx src/timeutil.cc || out
build out/var.o: cxx src/var.cc || out
build out/version_unknown.o: cxx src/version_unknown.cc || out
build out/main.o: cxx src/main.cc || out
build out/find_test.o: cxx src/find_test.cc || out
build out/ninja_test.o: cxx src/ninja_test.cc || out
build out/strutil_test.o: cxx src/strutil_test.cc || out

build ckati: link out/main.o out/affinity.o out/command.o out/dep.o out/eval.o out/exec.o out/expr.o out/file.o out/file_cache.o out/fileutil.o out/find.o out/flags.o out/func.o out/io.o out/log.o out/ninja.o out/parser.o out/regen.o out/regen_dump.o out/rule.o out/stats.o out/stmt.o out/stringprintf.o out/strutil.o out/symtab.o out/timeutil.o out/var.o out/version_unknown.o
build out/find_test: link out/find_test.o out/affinity.o out/command.o out/dep.o out/eval.o out/exec.o out/expr.o out/file.o out/file_cache.o out/fileutil.o out/find.o out/flags.o out/func.o out/io.o out/log.o out/ninja.o out/parser.o out/regen.o out/regen_dump.o out/rule.o out/stats.o out/stmt.o out/stringprintf.o out/strutil.o out/symtab.o out/timeutil.o out/var.o out/version_unknown.o
build out/ninja_test: link out/ninja_test.o out/affinity.o out/command.o out/dep.o out/eval.o out/exec.o out/expr.o out/file.o out/file_cache.o out/fileutil.o out/find.o out/flags.o out/func.o out/io.o out/log.o out/ninja.o out/parser.o out/regen.o out/regen_dump.o out/rule.o out/stats.o out/stmt.o out/stringprintf.o out/strutil.o out/symtab.o out/timeutil.o out/var.o out/version_unknown.o
build out/strutil_test: link out/strutil_test.o out/affinity.o out/command.o out/dep.o out/eval.o out/exec.o out/expr.o out/file.o out/file_cache.o out/fileutil.o out/find.o out/flags.o out/func.o out/io.o out/log.o out/ninja.o out/parser.o out/regen.o out/regen_dump.o out/rule.o out/stats.o out/stmt.o out/stringprintf.o out/strutil.o out/symtab.o out/timeutil.o out/var.o out/version_unknown.o
build tests: phony out/find_test out/ninja_test out/strutil_test
default ckati
