# Portable, GNU-free Linux build. Run with Ninja in a musl environment.
# Openmktr fork (2026): include load admission and native graph optimization modules.
# Require the stable FIFO jobserver and interruption fixes in Ninja 1.13.2.
ninja_required_version = 1.13.2
cxx = clang++
cxxflags = -std=c++17 -O2 -DNOLOG -Wall -Wextra -stdlib=libc++ -pthread -flto=thin -ffunction-sections -fdata-sections
ldflags = -stdlib=libc++ -fuse-ld=lld -pthread -flto=thin -Wl,--gc-sections -Wl,--icf=safe

rule mkdir
  command = mkdir -p $out
  description = MKDIR $out

rule cxx
  command = $cxx $cxxflags -MMD -MF $out.d -c $in -o $out
  depfile = $out.d
  deps = gcc
  description = CXX $out

rule version
  command = python3 tools/gen_version.py $out
  description = VERSION $out
  restat = 1

rule link
  command = $cxx $ldflags $test_ldflags $in -o $out
  description = LINK $out

build out: mkdir

build out/affinity.o: cxx src/affinity.cc || out
build out/command.o: cxx src/command.cc || out
build out/dep.o: cxx src/dep.cc || out
build out/eval.o: cxx src/eval.cc || out
build out/exec.o: cxx src/exec.cc || out
build out/ready_queue.o: cxx src/ready_queue.cc || out
build out/expr.o: cxx src/expr.cc || out
build out/file.o: cxx src/file.cc || out
build out/file_cache.o: cxx src/file_cache.cc || out
build out/fileutil.o: cxx src/fileutil.cc || out
build out/process.o: cxx src/process.cc || out
build out/jobserver.o: cxx src/jobserver.cc || out
build out/find.o: cxx src/find.cc || out
build out/flags.o: cxx src/flags.cc || out
build out/graph_optimization.o: cxx src/graph_optimization.cc || out
build out/graph_import.o: cxx src/graph_import.cc || out
build out/incremental_eval.o: cxx src/incremental_eval.cc || out
build out/native_observation.o: cxx src/native_observation.cc || out
build out/func.o: cxx src/func.cc || out
build out/io.o: cxx src/io.cc || out
build out/log.o: cxx src/log.cc || out
build out/ninja.o: cxx src/ninja.cc || out
build out/monitor.o: cxx src/monitor.cc || out
build out/parser.o: cxx src/parser.cc || out
build out/regen.o: cxx src/regen.cc || out
build out/recursive_cache.o: cxx src/recursive_cache.cc || out
build out/regen_dump.o: cxx src/regen_dump.cc || out
build out/rule.o: cxx src/rule.cc || out
build out/stats.o: cxx src/stats.cc || out
build out/stmt.o: cxx src/stmt.cc || out
build out/stringprintf.o: cxx src/stringprintf.cc || out
build out/strutil.o: cxx src/strutil.cc || out
build out/symtab.o: cxx src/symtab.cc || out
build out/timeutil.o: cxx src/timeutil.cc || out
build out/var.o: cxx src/var.cc || out
build out/version_generated.cc: version tools/gen_version.py || out
build out/version_generated.o: cxx out/version_generated.cc || out
build out/main.o: cxx src/main.cc || out
build out/ready_queue_test.o: cxx src/ready_queue_test.cc || out
build out/timeutil_test.o: cxx src/timeutil_test.cc || out
build out/find_test.o: cxx src/find_test.cc || out
build out/ninja_test.o: cxx src/ninja_test.cc || out
build out/strutil_test.o: cxx src/strutil_test.cc || out
build out/load_limit_test.o: cxx src/load_limit_test.cc || out

build omktr: link out/main.o out/affinity.o out/command.o out/dep.o out/eval.o out/exec.o out/ready_queue.o out/expr.o out/file.o out/file_cache.o out/fileutil.o out/process.o out/jobserver.o out/find.o out/flags.o out/graph_optimization.o out/graph_import.o out/incremental_eval.o out/native_observation.o out/func.o out/io.o out/log.o out/ninja.o out/monitor.o out/parser.o out/regen.o out/recursive_cache.o out/regen_dump.o out/rule.o out/stats.o out/stmt.o out/stringprintf.o out/strutil.o out/symtab.o out/timeutil.o out/var.o out/version_generated.o
build out/find_test: link out/find_test.o out/affinity.o out/command.o out/dep.o out/eval.o out/exec.o out/ready_queue.o out/expr.o out/file.o out/file_cache.o out/fileutil.o out/process.o out/jobserver.o out/find.o out/flags.o out/graph_optimization.o out/graph_import.o out/incremental_eval.o out/native_observation.o out/func.o out/io.o out/log.o out/ninja.o out/monitor.o out/parser.o out/regen.o out/recursive_cache.o out/regen_dump.o out/rule.o out/stats.o out/stmt.o out/stringprintf.o out/strutil.o out/symtab.o out/timeutil.o out/var.o out/version_generated.o
build out/ninja_test: link out/ninja_test.o out/affinity.o out/command.o out/dep.o out/eval.o out/exec.o out/ready_queue.o out/expr.o out/file.o out/file_cache.o out/fileutil.o out/process.o out/jobserver.o out/find.o out/flags.o out/graph_optimization.o out/graph_import.o out/incremental_eval.o out/native_observation.o out/func.o out/io.o out/log.o out/ninja.o out/monitor.o out/parser.o out/regen.o out/recursive_cache.o out/regen_dump.o out/rule.o out/stats.o out/stmt.o out/stringprintf.o out/strutil.o out/symtab.o out/timeutil.o out/var.o out/version_generated.o
build out/timeutil_test: link out/timeutil_test.o out/affinity.o out/command.o out/dep.o out/eval.o out/exec.o out/ready_queue.o out/expr.o out/file.o out/file_cache.o out/fileutil.o out/process.o out/jobserver.o out/find.o out/flags.o out/graph_optimization.o out/graph_import.o out/incremental_eval.o out/native_observation.o out/func.o out/io.o out/log.o out/ninja.o out/monitor.o out/parser.o out/regen.o out/recursive_cache.o out/regen_dump.o out/rule.o out/stats.o out/stmt.o out/stringprintf.o out/strutil.o out/symtab.o out/timeutil.o out/var.o out/version_generated.o
  test_ldflags = -Wl,--wrap=clock_gettime
build out/strutil_test: link out/strutil_test.o out/affinity.o out/command.o out/dep.o out/eval.o out/exec.o out/ready_queue.o out/expr.o out/file.o out/file_cache.o out/fileutil.o out/process.o out/jobserver.o out/find.o out/flags.o out/graph_optimization.o out/graph_import.o out/incremental_eval.o out/native_observation.o out/func.o out/io.o out/log.o out/ninja.o out/monitor.o out/parser.o out/regen.o out/recursive_cache.o out/regen_dump.o out/rule.o out/stats.o out/stmt.o out/stringprintf.o out/strutil.o out/symtab.o out/timeutil.o out/var.o out/version_generated.o
build out/load_limit_test: link out/load_limit_test.o
build out/ready_queue_test: link out/ready_queue_test.o out/ready_queue.o
build tests: phony out/ready_queue_test out/timeutil_test out/find_test out/ninja_test out/strutil_test out/load_limit_test
default omktr
